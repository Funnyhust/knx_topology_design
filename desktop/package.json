{
  "name": "knx-topology-desktop",
  "version": "0.1.2",
  "description": "Desktop wrapper for KNX Topology",
  "author": "KNX Topology Team",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:portable": "electron-builder --win zip --x64",
    "dist:mac": "electron-builder --mac zip --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "vn.knx.topology",
    "productName": "KNX Topology",
    "asar": true,
    "compression": "normal",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "package.json",
      "assets/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../src/main/webapp",
        "to": "webapp",
        "filter": [
          "**/*",
          "!WEB-INF{,/**/*}",
          "!META-INF{,/**/*}"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": [{ "target": "zip", "arch": ["arm64", "x64"] }],
      "artifactName": "KNX-Topology-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KNX-Topology-${version}-Portable-x64.${ext}"
    }
  }
}
